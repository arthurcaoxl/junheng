{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://junheng.local/contracts/identity-v1.schema.json",
  "title": "IdentityV1",
  "type": "object",
  "required": ["camperId", "enrollmentId", "state", "grantedRoles", "version", "createdAt", "updatedAt"],
  "additionalProperties": false,
  "properties": {
    "camperId": { "type": "string", "pattern": "^cam_[A-Za-z0-9]{16,64}$" },
    "enrollmentId": { "type": "string", "pattern": "^enr_[A-Za-z0-9]{16,64}$" },
    "state": { "type": "string", "enum": ["active", "suspended", "archived"] },
    "authSubjectRef": { "type": "string", "minLength": 3 },
    "grantedRoles": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "version": { "type": "integer", "minimum": 1 },
    "createdAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" },
    "updatedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" }
  },
  "examples": [
    {
      "camperId": "cam_01JYC8M4F6N2Q0A7R3T5V9XBDE",
      "enrollmentId": "enr_01JYC8M4F6N2Q0A7R3T5V9XBDE",
      "state": "active",
      "grantedRoles": ["camper"],
      "version": 1,
      "createdAt": "2026-10-29T08:40:00.000Z",
      "updatedAt": "2026-10-29T08:40:00.000Z"
    }
  ]
}
