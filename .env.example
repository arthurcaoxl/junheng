# Copy to .env for local overrides. Never commit .env.
COMPOSE_PROJECT_NAME=junheng
VITE_APP_ENV=development

# Supabase（apps/web 前端直连，仅 anon 公钥；构建时内联，发布用带 .env 的本地构建）
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-side only. Never expose this through a VITE_ variable or the browser bundle.
SUPABASE_SERVICE_ROLE_KEY=
